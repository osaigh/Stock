<UserControl x:Class="Stock.WpfClient.Surveillance.Views.SurveillanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:charts="clr-namespace:Stock.WpfClient.Surveillance.Charts"
             xmlns:local="clr-namespace:Stock.WpfClient.Surveillance.Views"
             xmlns:Converters="clr-namespace:Stock.WpfClient.Surveillance.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Converters:CurrencyConverter x:Key="currencyConverter" />
    </UserControl.Resources>
    <Grid Visibility="{Binding SignedInVisibility}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
       
        <Border Margin="0,0,10,0" BorderBrush="LightGray" BorderThickness="1">
            <ListView BorderThickness="0" Width="Auto"
                  
                  ItemsSource="{Binding Path=Stocks}"  HorizontalContentAlignment="Stretch"
                  SelectedItem="{Binding Path=SelectedStock, Mode=TwoWay}"  AlternationCount="2"
                  IsSynchronizedWithCurrentItem="True" AutomationProperties.AutomationId="StockGrid" Foreground="#FF121723" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListView.View>
                    <GridView AllowsColumnReorder="true" ColumnHeaderToolTip="Current positions"
                          >
                        <GridViewColumn Header="Id" 
                  DisplayMemberBinding="{Binding Path=Id}" 
                   Width="85"/>
                        <GridViewColumn Header="Name"  
                  DisplayMemberBinding="{Binding Path=Name}"
                  Width="85" />
                        <GridViewColumn Header="Price"  
                  DisplayMemberBinding="{Binding Converter={StaticResource currencyConverter}, Path=Price}"
                  Width="85" />
                        <GridViewColumn Header="Cost Volume"  
                  DisplayMemberBinding="{Binding Path=Volume}"
                  Width="85" />

                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <Border Margin="10,0,0,0" Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Visibility="{Binding ChartVisibility}">
            <charts:LineChartControl XaxisValues="{Binding XaxisValues}" DataSeries="{Binding DataSeries}" 
                                     Ymax="{Binding Ymax}" 
                                     Ymin="{Binding Ymin}"
                                     Xmin="{Binding Xmin}"
                                     Xmax="{Binding Xmax}"
                                     LegendPosition="NorthWest"
                                     IsLegend="True"
                                     Title="{Binding ChartTitle}"/>
        </Border>
    </Grid>
</UserControl>
