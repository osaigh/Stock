<UserControl x:Class="Stock.WpfClient.Authentication.Views.SignInMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Stock.WpfClient.Authentication.Views"
             mc:Ignorable="d" 
             >
    <Grid Visibility="{Binding SignedOutVisibility}">
        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Content="Please Sign In" />
    </Grid>
</UserControl>
